# Copy to .env (setup.ps1 does this for you). NEVER commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# App database user (restricted). Password is set by setup.ps1.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=officecms
DB_USER=officecms_app
DB_PASSWORD=change_me

# Migrations run as the owner user (can create tables). Not used by the running app.
DB_OWNER_USER=officecms_owner
DB_OWNER_PASSWORD=change_me

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Browser origin allowed to call the API in development (Vite)
CLIENT_ORIGIN=http://localhost:5173

STORAGE_DIR=../storage
MAX_UPLOAD_MB=25
